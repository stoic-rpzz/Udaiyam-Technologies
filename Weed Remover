<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Our Portfolio</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; color: #222; background: #f5f7fa; }
    header { background: #2b50ff; color: #fff; text-align: center; padding: 48px 20px; }
    main { max-width: 900px; margin: 0 auto; padding: 32px 20px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .card { background: #fff; border-radius: 10px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .card h3 { margin-top: 0; }
    footer { text-align: center; padding: 24px; color: #666; }
  </style>
</head>
<body>
  <header>
    <h1>Our Portfolio</h1>
    <p>A showcase of the work we are proud of.</p>
  </header>

  <main>
    <h2>Projects</h2>
    <div class="grid">
      <div class="card">
        <h3>Project One</h3>
        <p>Short description of the first project.</p>
      </div>
      <div class="card">
        <h3>Project Two</h3>
        <p>Short description of the second project.</p>
      </div>
      <div class="card">
        <h3>Project Three</h3>
        <p>Short description of the third project.</p>
      </div>
    </div>

    <h2>Contact</h2>
    <p>Email us at <a href="mailto:hello@example.com">hello@example.com</a></p>
  </main>

  <footer>© 2026 Our Company</footer>
</body>
</html>
